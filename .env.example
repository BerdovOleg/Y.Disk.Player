# Yandex OAuth (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback

# Fernet key for encrypting Yandex tokens at rest
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Root folder on Yandex Disk for the music library
DISK_ROOT=/Music

# SQLite path
DATABASE_PATH=data/onemoretime.db

# Dev stub: when YANDEX_* are empty, allow local login without real OAuth
ALLOW_DEV_AUTH=1

# Torrent download directory (temp before Disk upload)
TORRENT_DOWNLOAD_DIR=data/torrents
