# Runtime mode: development | production
# In production: ALLOW_DEV_AUTH is forced off; Secure cookies default on; HSTS on.
ENVIRONMENT=development

# Yandex OAuth (https://oauth.yandex.ru/)
# Enable Disk permissions on the app itself (default scopes):
#   cloud_api:disk.read, cloud_api:disk.write, cloud_api:disk.info
# Leave YANDEX_OAUTH_SCOPES empty unless you intentionally override; requesting
# scopes not enabled on the app breaks login with error=invalid_scope.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Local:
OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# Production example:
# OAUTH_REDIRECT_URI=https://music.example.com/auth/callback
YANDEX_OAUTH_SCOPES=

# Fernet key for encrypting Yandex tokens at rest (never log this)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Session cookie signing secret (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Cookie flags (Secure defaults on when ENVIRONMENT=production)
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Comma-separated browser Origins allowed for mutating /api and /auth
TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Production example:
# TRUSTED_ORIGINS=https://music.example.com

# Optional IP/CIDR allowlist (empty = allow all). Useful for family VPS.
# IP_ALLOWLIST=203.0.113.10,198.51.100.0/24
IP_ALLOWLIST=

# Auth endpoint rate limit per IP per minute
AUTH_RATE_LIMIT_PER_MIN=20

# Root folder on Yandex Disk for the music library (per-user Disk token)
DISK_ROOT=/Music

# SQLite path
DATABASE_PATH=data/onemoretime.db

# Dev stub: when YANDEX_* are empty, allow local login without real OAuth.
# Forced OFF when ENVIRONMENT=production.
ALLOW_DEV_AUTH=1

# Torrent download directory (temp before Disk upload)
TORRENT_DOWNLOAD_DIR=data/torrents

# Background Disk rescan (hours). Set 0 to disable.
DISK_SCAN_INTERVAL_HOURS=6

# Hot stream cache (frequently played tracks; isolated per user_id)
TRACK_CACHE_DIR=data/cache/tracks
TRACK_CACHE_TTL_HOURS=24
TRACK_CACHE_MAX_BYTES=2147483648
# Bytes buffered before marking progressive early-play ready (passthrough starts sooner)
STREAM_EARLY_BYTES=524288
