[Unit]
Description=OneMoreTime music library (uvicorn)
After=network.target

[Service]
Type=simple
User=omt
Group=omt
WorkingDirectory=/opt/onemoretime
EnvironmentFile=/opt/onemoretime/.env
ExecStart=/opt/onemoretime/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
